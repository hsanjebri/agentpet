{
  "name": "agentpet",
  "version": "0.4.1",
  "description": "A desktop pet that babysits your AI coding agent",
  "main": "./out/main/index.js",
  "author": "AgentPet",
  "homepage": "https://github.com/hsanjebri/agentpet",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir --publish never",
    "build:win": "npm run helper:build && npm run build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:preview": "node scripts/install-hooks.mjs --dry-run",
    "hooks:uninstall": "node scripts/uninstall-hooks.mjs",
    "icons": "vitest run --config scripts/icons/vitest.config.mts",
    "helper:build": "dotnet publish helper/nowplaying -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o helper/nowplaying/dist"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "qrcode-generator": "^1.4.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "productName": "AgentPet",
  "license": "MIT"
}
